# Copy this file to .env to change the passwords docker compose starts Sentinel with:
#
#   cp .env.example .env        (Windows PowerShell: copy .env.example .env)
#
# docker compose reads .env by itself. Leave any line out and the default from
# docker-compose.yml is used, which is fine on your own laptop. Set all of them before
# running this anywhere that other people can reach.
#
# .env is in .gitignore and must stay out of git: it holds real passwords.

# The database password, used by Postgres and by the backend that connects to it.
POSTGRES_PASSWORD=sentinel

# The API key payment systems send with every decision request (the X-API-Key header).
SENTINEL_API_KEY=dev-sentinel-key

# The two console accounts created on first start: admin (Arjun Rao) and analyst (Neha Kapoor).
SENTINEL_ADMIN_PASSWORD=sentinel-admin
SENTINEL_ANALYST_PASSWORD=sentinel-analyst
